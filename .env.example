# Exemplo de configuração de variáveis de ambiente para o FinancialManager
# Copie este arquivo para .env na raiz do projeto e ajuste os valores conforme o seu ambiente

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/financialmanager
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=sua_senha_aqui

# JWT (HS256 Base64 com no mínimo 256 bits / 32 bytes)
JWT_SECRET=coloque_uma_chave_base64_ou_string_com_no_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=financial-manager-api
